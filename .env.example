# Dominio definitivo del sitio. Alimenta canónicas, sitemap, robots y schema.
# Si no se define, se asume https://perlatorres.com
NEXT_PUBLIC_SITE_URL=https://perlatorres.com

# --- Formulario de contacto (Resend) ---------------------------------
# Clave del panel de Resend: https://resend.com/api-keys
RESEND_API_KEY=
# Remitente verificado en Resend, con el dominio ya validado.
CORREO_REMITENTE="Perla Torres <hola@perlatorres.com>"
# Bandeja donde caen los mensajes. Si se omite, usa el correo público.
CORREO_DESTINO=perlatorres@talentoria.com

# --- Medición y verificación (opcionales) -----------------------------
# ID de Google Analytics 4, formato G-XXXXXXXXXX. Mientras no exista, el
# sitio no carga nada de Google ni deja cookies. Es NEXT_PUBLIC_, así que
# hay que REDESPLEGAR después de definirla: se hornea en el build.
NEXT_PUBLIC_GA_ID=
# Token de verificación de Google Search Console por etiqueta HTML: solo el
# valor del atributo content, sin la etiqueta completa.
GOOGLE_SITE_VERIFICATION=
